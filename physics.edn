;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a tannery scheduling/logistics coordination
;; robot schedules the crew, logs batches/inventory and coordinates
;; tanning-chemical and raw-hide supply; it never tans. Its physical work is
;; tannery logistics: moving pallets of wet hides between process stages, and
;; the float drain of a paddle vat that has to finish before hides are moved
;; out (the robot schedules around it).
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-7535"
 :cases
 [{:id :wet-hide-pallet
   :kind :transport
   :procedure "pallet mover carries a pallet of wet hides from the drum house to the sammying machine"
   :params {:mass-kg 250.0 :distance-m 60.0 :v-max-mps 1.0 :a-max-mps2 0.4
            :brake-decel-mps2 1.0 :drive-force-n 600.0 :crr 0.02
            :cog-height-m 0.30 :payload-cog-height-m 0.50 :support-half-length-m 0.50
            :max-time-s 1200.0}
   :sweep {:param :payload-kg :values [200.0 400.0 700.0 1000.0 1400.0]}
   :quantity :cycle-time-s
   :limit {:max 75.0 :basis "estimate: one pallet leg must fit between drum unloads in the shift schedule"}
   :boundary {:lo 100.0 :hi 3000.0}}
  {:id :paddle-vat-float-drain
   :kind :tank-drain
   :procedure "paddle vat float is drained through the bottom valve before hides are lifted out"
   :params {:tank-area-m2 6.0 :h0-m 1.4 :h-target-m 0.1 :cd 0.62 :dt-s 1.0}
   :sweep {:param :orifice-area-m2 :values [0.002 0.004 0.008 0.012 0.02]}
   :quantity :time-to-target-s
   :limit {:max 1200.0 :basis "estimate: a 20-minute drain window between process stages in the batch schedule"}
   :boundary {:lo 0.001 :hi 0.05}}]}
